@model MessageAnalysisViewModel
<div class="ai-card">

    <div class="ai-header">
        <div class="ai-icon">
            <i data-feather="cpu"></i>
        </div>

        <div>
            <small>AL ANALİZ</small>
            <h4>Bu Haftanın Özeti</h4>
        </div>
    </div>

    <div class="ai-body">

        <span class="ai-status">
            <i data-feather="check-circle"></i>
            Analiz tamamlandı
        </span>

        <h3>
            Mesaj trafiğiniz
            <span>@Model.Activity</span>
        </h3>

        <p>
            @Model.Summary
        </p>

    </div>

    <div class="ai-topic">
        <div class="topic-icon">
            <i data-feather="briefcase"></i>
        </div>

        <div>
            <small>Öne çıkan konu</small>
            <strong>@Model.MainTopic</strong>
        </div>
    </div>

    <div class="ai-footer">
        <span>
            <i data-feather="clock"></i>
            Son 7 gün
        </span>

        <b>@Model.Tone</b>
    </div>
</div>

                <style>
.ai-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 460px;
    padding: 28px;
    border-radius: 22px;
    background: linear-gradient(145deg, #ffffff 0%, #fbf7ff 55%, #f4ebff 100%);
    border: 1px solid #eee4fa;
    box-shadow: 0 14px 35px rgba(91, 55, 130, .12);
    overflow: hidden;
}

    /* dekoratif renkli alanlar */
    .ai-card:before {
        content: "";
        position: absolute;
        width: 190px;
        height: 190px;
        right: -75px;
        top: -75px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e9d4ff, #f5eaff);
    }

    .ai-card:after {
        content: "";
        position: absolute;
        width: 110px;
        height: 110px;
        left: -55px;
        bottom: -45px;
        border-radius: 50%;
        background: #f1ddff;
    }

/* Header */
.ai-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
}

.ai-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    background: linear-gradient(135deg, #f0dfff, #e8caff);
    color: #9948df;
    box-shadow: 0 7px 18px rgba(153, 72, 223, .15);
}

    .ai-icon svg {
        width: 22px;
    }

.ai-header small {
    color: #9948df;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .5px;
}

.ai-header h4 {
    margin: 3px 0 0;
    color: #303044;
    font-size: 20px;
    font-weight: 600;
}

/* İçerik */
.ai-body {
    position: relative;
    z-index: 2;
    margin-top: 38px;
}

.ai-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #50b989;
    font-size: 11px;
    font-weight: 500;
}

    .ai-status svg {
        width: 15px;
    }

.ai-body h3 {
    max-width: 450px;
    margin: 16px 0 12px;
    color: #303044;
    font-size: 25px;
    line-height: 1.4;
    font-weight: 400;
}

    .ai-body h3 span {
        color: #9948df;
        font-weight: 700;
    }

.ai-body p {
    max-width: 470px;
    margin: 0;
    color: #85818f;
    font-size: 12px;
    line-height: 1.8;
}

/* Konu kutusu */
.ai-topic {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding: 15px;
    border-radius: 15px;
    background: rgba(255,255,255,.75);
    border: 1px solid #eee2fa;
}

.topic-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: #f0ddff;
    color: #9948df;
}

    .topic-icon svg {
        width: 17px;
    }

.ai-topic small {
    display: block;
    margin-bottom: 3px;
    color: #aaa5b2;
    font-size: 10px;
}

.ai-topic strong {
    color: #3e3a4d;
    font-size: 13px;
}

/* Alt bölüm */
.ai-footer {
    position: absolute;
    z-index: 2;
    left: 28px;
    right: 28px;
    bottom: 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

    .ai-footer span {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #9994a1;
        font-size: 10px;
    }

        .ai-footer span svg {
            width: 14px;
        }

    .ai-footer b {
        padding: 6px 11px;
        border-radius: 20px;
        background: linear-gradient(135deg, #f0ddff, #e5c8ff);
        color: #9948df;
        font-size: 9px;
}</style>